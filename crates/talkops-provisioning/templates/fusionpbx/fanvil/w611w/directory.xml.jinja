            <Telephone>{{ ((lookup(number | default(none), ["phone_number"]) | default(''))) | output }}</Telephone>
        {% elif  not ((lookup(ns | default(none), ["telephone_set"]) is defined and lookup(ns | default(none), ["telephone_set"]) is not none))  and  (lookup(number | default(none), ["phone_number"]) | default('')) != "" %}
            <Telephone>{{ ((lookup(number | default(none), ["phone_number"]) | default(''))) | output }}</Telephone>
