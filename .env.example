# TalkOps configuration. Copy to `.env` (or paste into Portainer's stack
# environment) and set every value marked REQUIRED.
# Generate secrets with: openssl rand -hex 32

# Image tag to deploy (e.g. 0.1.0, 0.1, latest)
TALKOPS_VERSION=latest

# --- Database ---------------------------------------------------------------
POSTGRES_USER=talkops
# REQUIRED. Use letters and digits only (it is embedded in a connection URL).
POSTGRES_PASSWORD=
POSTGRES_DB=talkops
# Host port Postgres is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- Secrets ----------------------------------------------------------------
# REQUIRED. Key used to encrypt SIP and trunk credentials at rest (hex, 64 chars).
# Back it up: without it, stored credentials cannot be decrypted.
TALKOPS_SECRET_KEY=
# REQUIRED. FreeSWITCH event socket password (no " < > & characters).
TALKOPS_ESL_PASSWORD=
# REQUIRED. Password FreeSWITCH uses to fetch its configuration from TalkOps.
TALKOPS_XMLCURL_PASSWORD=

# --- Network ----------------------------------------------------------------
# Web UI / API. Keep TALKOPS_HTTP_PORT equal to the port in TALKOPS_LISTEN.
TALKOPS_LISTEN=0.0.0.0:8080
TALKOPS_HTTP_PORT=8080
TALKOPS_ESL_PORT=8021
# SIP ports: phones (internal) and trunks (external).
TALKOPS_SIP_PORT=5060
TALKOPS_SIP_TRUNK_PORT=5080
# RTP media ports (UDP). 600 ports are enough for ~150 simultaneous calls.
TALKOPS_RTP_START_PORT=16384
TALKOPS_RTP_END_PORT=16999

# Optional HTTPS via Caddy: set both lines.
# COMPOSE_PROFILES=caddy
# TALKOPS_DOMAIN=pbx.example.com

# --- Transcription ------------------------------------------------------------
# Whisper model for call and voicemail transcripts (downloaded on first use):
# large-v3-turbo-q5_0 (~550 MB, accurate, ~2 GB RAM), small (~490 MB, for
# weak hardware) or base (~150 MB, fast but inaccurate).
TALKOPS_WHISPER_MODEL=large-v3-turbo-q5_0
# Skip silence and hold music before transcribing (recommended).
TALKOPS_WHISPER_VAD=true

# --- Optional: Coral Edge TPU speech recognition (ADR 0046) ------------------
# Enable the coral-stt service with COMPOSE_PROFILES=coral (combine profiles
# with commas, e.g. coral,caddy). It listens on 127.0.0.1 only.
#   TALKOPS_CORAL_PORT: port on 127.0.0.1; the connection URL in TalkOps is
#                       http://127.0.0.1:<port>/v1
#   TALKOPS_CORAL_GID:  host group that owns the TPU device: plugdev (46) for
#                       the USB Accelerator, the "apex" group for PCIe/M.2
#   TALKOPS_CORAL_API_KEY: optional; then enter the same key in TalkOps
#   TALKOPS_CORAL_QUEUE: windows that may wait for a TPU before HTTP 503
#   TALKOPS_CORAL_SESSIONS_PER_TPU: live channels (two per call) per TPU
#   TALKOPS_CORAL_MODEL_ADMIN: false disables model upload in the TalkOps UI
# COMPOSE_PROFILES=coral
TALKOPS_CORAL_PORT=8095
TALKOPS_CORAL_GID=46
TALKOPS_CORAL_API_KEY=
TALKOPS_CORAL_QUEUE=16
TALKOPS_CORAL_SESSIONS_PER_TPU=4
TALKOPS_CORAL_MODEL_ADMIN=true
# Default for direct service clients. TalkOps uses the per-profile UI setting.
# Experimental: publish only complete words from stable model frames.
# Model-dependent delay is about 4–5 s; this is not a maximum guarantee.
TALKOPS_CORAL_STABLE_PREVIEW=false

# --- Optional: NVIDIA GPU speech recognition (ADR 0052) ----------------------
# Enable the cuda-stt service with COMPOSE_PROFILES=cuda. Host: NVIDIA driver
# 580 or later and the NVIDIA Container Toolkit. It listens on 127.0.0.1 only.
#   TALKOPS_CUDA_DEVICE: GPU index (nvidia-smi) that the service uses
#   TALKOPS_CUDA_PORT: port on 127.0.0.1; the connection URL in TalkOps is
#                      http://127.0.0.1:<port>/v1
#   TALKOPS_CUDA_API_KEY: optional; then enter the same key in TalkOps
#   TALKOPS_CUDA_QUEUE: jobs that may wait for the GPU before HTTP 503
#   TALKOPS_CUDA_SESSIONS: live channels (two per call)
#   TALKOPS_CUDA_PARTIAL_INTERVAL_MS: a live turn is decoded again after
#                      this much new audio (lower: faster text, more GPU load)
#   TALKOPS_CUDA_MODEL_ADMIN: false disables model installation in the UI
#   TALKOPS_CUDA_MAX_LIBRARY_MB: disk space of the model library
# COMPOSE_PROFILES=cuda
TALKOPS_CUDA_DEVICE=0
TALKOPS_CUDA_PORT=8096
TALKOPS_CUDA_API_KEY=
TALKOPS_CUDA_QUEUE=32
TALKOPS_CUDA_SESSIONS=8
TALKOPS_CUDA_PARTIAL_INTERVAL_MS=1000
TALKOPS_CUDA_MODEL_ADMIN=true
TALKOPS_CUDA_MAX_LIBRARY_MB=20480
TALKOPS_CUDA_STABLE_PREVIEW=false

# --- Monitoring ---------------------------------------------------------------
# Optional. Enables the Prometheus endpoint /metrics; Prometheus sends this
# token as bearer token. Empty: endpoint disabled.
TALKOPS_METRICS_TOKEN=

# --- Optional: TURN relay for the browser softphone -------------------------
# Media over one port (3478) instead of the RTP range, e.g. from outside
# without VPN. Enable the coturn service with COMPOSE_PROFILES=turn.
#   TALKOPS_TURN_SECRET: long random value, e.g. `openssl rand -hex 32`
#   TALKOPS_TURN_URLS:   how browsers reach coturn (domain or public IP)
#   TALKOPS_TURN_PEER_IP: LAN address of this host (FreeSWITCH media)
# COMPOSE_PROFILES=turn
TALKOPS_TURN_SECRET=
TALKOPS_TURN_URLS=
# TALKOPS_TURN_URLS=turn:pbx.example.com:3478?transport=udp,turn:pbx.example.com:3478?transport=tcp
TALKOPS_TURN_PEER_IP=
TALKOPS_TURN_RELAY_ONLY=false

# --- Logging ----------------------------------------------------------------
TZ=Europe/Berlin
TALKOPS_LOG_FORMAT=json
RUST_LOG=info
TALKOPS_FS_LOG_LEVEL=info

# --- Recovery ---------------------------------------------------------------
# Optional local token for archive inspection during first setup (32+ characters).
# Remove it after setup. Generate with: openssl rand -hex 32
TALKOPS_SETUP_TOKEN=
# Complete backups: use docker-compose.backup.yml and a private backup-password
# file readable by UID 10001. Never put TALKOPS_BACKUP_PASSWORD in this .env.
# TalkOps captures .env, *.env and (docker-)compose*.yml files of this directory
# automatically (auto). Set a comma-separated list to select files explicitly.
# TALKOPS_DEPLOYMENT_FILES=auto
# TALKOPS_DEPLOYMENT_SOURCE=.
# TALKOPS_BACKUP_PASSWORD_SOURCE=./backup-password
# Backup targets (settings > system): remote targets need the backup password.
# Local targets must be below these container directories; mount host folders,
# USB disks or NFS volumes there (example: docker-compose.targets.yml).
# TALKOPS_BACKUP_TARGET_ROOTS=/var/lib/talkops/targets
# TALKOPS_NFS_HOST=nas.local
# TALKOPS_NFS_EXPORT=/export/talkops
