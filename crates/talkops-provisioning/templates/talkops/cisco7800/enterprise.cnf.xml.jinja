{# Independently authored experimental Enterprise profile; no firmware or trust files. #}
<?xml version="1.0" encoding="UTF-8"?>
<device>
  <fullConfig>true</fullConfig>
  <deviceProtocol>SIP</deviceProtocol>
  <devicePool>
    <dateTimeSetting>
      <dateTemplate>D.M.Y</dateTemplate>
      <timeZone>{{ cisco_enterprise_timezone }}</timeZone>
      <ntps><ntp><name>{{ ntp_server_primary }}</name><ntpMode>Unicast</ntpMode></ntp></ntps>
    </dateTimeSetting>
    <callManagerGroup><members><member priority="0"><callManager>
      <ports><sipPort>{{ account['1'].sip_port }}</sipPort></ports>
      <processNodeName>{{ server_address }}</processNodeName>
    </callManager></member></members></callManagerGroup>
  </devicePool>
  <sipProfile>
    <sipProxies><registerWithProxy>true</registerWithProxy></sipProxies>
    <enableVad>false</enableVad>
    <preferredCodec>g711alaw</preferredCodec>
    <dtmfAvtPayload>101</dtmfAvtPayload>
    <dtmfOutofBand>avt</dtmfOutofBand>
    <kpml>0</kpml>
    <natEnabled>false</natEnabled>
    <phoneLabel>{{ device_label }}</phoneLabel>
    <sipLines>
{% for row in lines %}{% if row.enabled %}
      <line button="1" lineIndex="1">
        <featureID>9</featureID>
        <featureLabel>{{ row.label }}</featureLabel>
        <proxy>USECALLMANAGER</proxy><port>{{ row.sip_port }}</port>
        <name>{{ row.user_id }}</name><displayName>{{ row.display_name }}</displayName>
        <authName>{{ row.auth_id }}</authName><authPassword>{{ row.password }}</authPassword>
        <contact>{{ row.user_id }}</contact><sharedLine>false</sharedLine>
        <messagesNumber>{{ voicemail_number }}</messagesNumber>
        <messageWaitingLampPolicy>3</messageWaitingLampPolicy>
        <ringSettingIdle>4</ringSettingIdle><ringSettingActive>5</ringSettingActive>
        <maxNumCalls>2</maxNumCalls><busyTrigger>2</busyTrigger>
      </line>
{% endif %}{% endfor %}
    </sipLines>
    <dialTemplate>dialplan.xml</dialTemplate>
  </sipProfile>
  <deviceSecurityMode>1</deviceSecurityMode>
  <transportLayerProtocol>1</transportLayerProtocol>
  <vendorConfig><webAccess>1</webAccess><sshAccess>1</sshAccess></vendorConfig>
</device>
