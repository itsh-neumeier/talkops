<tbook complete="true">
{% set ns.x = 1 %}
{% for row in (contacts | default('')) | values %}
	<item context="active" type="" fav="false" mod="false" index="{{ ((lookup(ns | default(none), ["x"]) | default(''))) | output }}">
		{% if (lookup(row | default(none), ["contact_name_given"]) | default('')) != "" %}
			<name>{{ ((lookup(row | default(none), ["contact_name_given"]) | default(''))) | output }} {{ ((lookup(row | default(none), ["contact_name_family"]) | default(''))) | output }}</name>
		{% else %}
			<name>{{ ((lookup(row | default(none), ["contact_organization"]) | default(''))) | output }}</name>
		{% endif %}
		{% for number in (lookup(row | default(none), ["numbers"]) | default('')) | values %}
			{% if (lookup(number | default(none), ["phone_number"]) | default('')) != "" %}
				<number>{{ ((lookup(number | default(none), ["phone_number"]) | default(''))) | output }}</number>
			{% else %}		
				<number>{{ ((lookup(number | default(none), ["phone_extension"]) | default(''))) | output }}</number>
			{% endif %}
		{% endfor %}
	</item>
    {% set ns.x = (lookup(ns | default(none), ["x"]) | default(0) | int)+1 %}
{% endfor %}
</tbook>
