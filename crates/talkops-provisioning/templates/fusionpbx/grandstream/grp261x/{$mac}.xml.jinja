		<!-- HTTP/HTTPS User Name  -->
		<item name="phonebook.download.username">{{ ((http_auth_username | default(''))) | output }}</item>

		<!-- HTTP/HTTPS Password  -->
		<item name="phonebook.download.password">{{ ((http_auth_password | default(''))) | output }}</item>

