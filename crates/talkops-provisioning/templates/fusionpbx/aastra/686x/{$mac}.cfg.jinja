{% elif (lookup(row | default(none), ["device_key_category"]) | default('')) == "expansion" %}
expmod4 key{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-180) | output }} type: {{ ((lookup(row | default(none), ["device_key_type"]) | default(''))) | output }}
expmod4 key{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-180) | output }} line: {{ ((lookup(row | default(none), ["device_key_line"]) | default(''))) | output }}
expmod4 key{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-180) | output }} value: {{ ((lookup(row | default(none), ["device_key_value"]) | default(''))) | output }}
