{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, snom/D715/{$mac}.xml, blob 618780604c9b81c60a6b720be3e56cd0e5ee357a. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}<?xml version="1.0" encoding="utf-8"?>
<settings>
  <phone-settings e="2">
    <!-- Basic Settings -->
    <web_language perm="">{% if ((snom_language is defined and snom_language is not none)) %}{{ ((snom_language | default(''))) | output }}{% else %}English{% endif %}</web_language>
    <language perm="">{% if ((snom_language is defined and snom_language is not none)) %}{{ ((snom_language | default(''))) | output }}{% else %}English{% endif %}</language>
    <tone_scheme perm="">{% if ((snom_tone_scheme is defined and snom_tone_scheme is not none)) %}{{ ((snom_tone_scheme | default(''))) | output }}{% else %}USA{% endif %}</tone_scheme>
    <ntp_server perm="">{% if ((snom_ntp_server is defined and snom_ntp_server is not none)) %}{{ ((snom_ntp_server | default(''))) | output }}{% else %}0.pool.ntp.org{% endif %}</ntp_server>
    <ntp_refresh_timer perm="">3600</ntp_refresh_timer>
    <timezone perm="">{{ ((snom_time_zone | default(''))) | output }}</timezone>
    {% if ((snom_dhcp is defined and snom_dhcp is not none)) %}<dhcp perm="R">{{ ((snom_dhcp | default(''))) | output }}</dhcp>{% endif %}
    <phone_name perm="R">snomD715-{{ (substring((mac | default('')),-6)) | output }}</phone_name>
    <dim_timer perm="">20</dim_timer>
    <backlight perm="">15</backlight>
    <backlight_idle perm="">5</backlight_idle>
    <display_method perm="">display_name_number</display_method>
    <global_missed_counter perm="">on</global_missed_counter>
    <dialnumber_us_format perm="">on</dialnumber_us_format>
    <show_ivr_digits perm="">off</show_ivr_digits>
    <cw_dialtone perm="">{% if ((snom_dialtone_on_hold is defined and snom_dialtone_on_hold is not none)) %}{{ ((snom_dialtone_on_hold | default(''))) | output }}{% else %}true{% endif %}</cw_dialtone>
    <answer_after_policy perm="">{% if ((snom_answer_after_policy is defined and snom_answer_after_policy is not none)) %}{{ ((snom_answer_after_policy | default(''))) | output }}{% else %}off{% endif %}</answer_after_policy>
    <keyboard_lock_emergency perm="R">{% if ((snom_emergency_numbers is defined and snom_emergency_numbers is not none)) %}{{ ((snom_emergency_numbers | default(''))) | output }}{% else %}911 112 110 999{% endif %}</keyboard_lock_emergency>
    <status_msgs_that_are_blocked perm="R">{% if ((snom_emergency_numbers is defined and snom_emergency_numbers is not none)) %}EmergencyCallNumbersMisconfigured{% endif %}</status_msgs_that_are_blocked>
    <!-- Ringtones -->
    <alert_internal_ring_text perm="">alert-internal</alert_internal_ring_text>
    <alert_internal_ring_sound perm="">{% if ((snom_alert_internal is defined and snom_alert_internal is not none)) %}{{ ((snom_alert_internal | default(''))) | output }}{% else %}Ringer1{% endif %}</alert_internal_ring_sound>
    <alert_external_ring_text perm="">alert-external</alert_external_ring_text>
    <alert_external_ring_sound perm="">{% if ((snom_alert_external is defined and snom_alert_external is not none)) %}{{ ((snom_alert_external | default(''))) | output }}{% else %}Ringer1{% endif %}</alert_external_ring_sound>
    <alert_group_ring_text perm="">alert-group</alert_group_ring_text>
    <alert_group_ring_sound perm="">{% if ((snom_alert_group is defined and snom_alert_group is not none)) %}{{ ((snom_alert_group | default(''))) | output }}{% else %}Ringer1{% endif %}</alert_group_ring_sound>
    <colleagues_ring_sound perm="">{% if ((snom_colleagues_ring_sound is defined and snom_colleagues_ring_sound is not none)) %}{{ ((snom_colleagues_ring_sound | default(''))) | output }}{% else %}Ringer1{% endif %}</colleagues_ring_sound>
    <!-- SIP Settings -->
    <mwi_notification perm="">silent</mwi_notification>
    <mwi_dialtone perm="">stutter</mwi_dialtone>
    <enable_rport_rfc3581 perm="RW">on</enable_rport_rfc3581>
    <privacy_in perm="">off</privacy_in>
    <privacy_out perm="">off</privacy_out>
    <quick_transfer perm="">{% if ((snom_quick_transfer is defined and snom_quick_transfer is not none)) %}{{ ((snom_quick_transfer | default(''))) | output }}{% else %}new_call{% endif %}</quick_transfer>
    <transfer_dialing_on_transfer perm="">{% if ((snom_transfer_dialing_on_transfer is defined and snom_transfer_dialing_on_transfer is not none)) %}{{ ((snom_transfer_dialing_on_transfer | default(''))) | output }}{% else %}blind{% endif %}</transfer_dialing_on_transfer>
    <transfer_dialing_on_other perm="">{% if ((snom_transfer_dialing_on_other is defined and snom_transfer_dialing_on_other is not none)) %}{{ ((snom_transfer_dialing_on_other | default(''))) | output }}{% else %}blind{% endif %}</transfer_dialing_on_other>
    <call_screen_fkeys_on_connected perm="">F_HOLD F_TRANSFER F_CONFERENCE</call_screen_fkeys_on_connected>
    <!-- Updates -->
    <update_policy perm="">{% if ((snom_update_policy is defined and snom_update_policy is not none)) %}{{ ((snom_update_policy | default(''))) | output }}{% else %}auto_update{% endif %}</update_policy>
    <setting_server perm="RW">{% if ((snom_provision_url is defined and snom_provision_url is not none)) %}{{ ((snom_provision_url | default(''))) | output }}{% else %}{{ ((primary_url | default(''))) | output }}{% endif %}</setting_server>
    <settings_refresh_timer perm="RW">{% if ((snom_provision_timer_seconds is defined and snom_provision_timer_seconds is not none)) %}{{ ((snom_provision_timer_seconds | default(''))) | output }}{% else %}0{% endif %}</settings_refresh_timer>
    <http_client_user perm="">{{ ((http_auth_username | default(''))) | output }}</http_client_user>
    <http_client_pass perm="">{{ ((http_auth_password | default(''))) | output }}</http_client_pass>
    <!-- Admin Access -->
    {% if ((admin_password is defined and admin_password is not none)) %}
    <http_user perm="RW">{{ ((admin_name | default(''))) | output }}</http_user>
    <http_pass perm="RW">{{ ((admin_password | default(''))) | output }}</http_pass>
    <web_logout_timer>5</web_logout_timer>
    <admin_mode perm="RW">on</admin_mode>
    <admin_mode_password perm="RW">{{ ((snom_admin_mode_password | default(''))) | output }}</admin_mode_password>
    <admin_mode_password_confirm perm="RW">{{ ((snom_admin_mode_password | default(''))) | output }}</admin_mode_password_confirm>
    {% else %}
    <admin_mode perm="RW">on</admin_mode>
    <admin_mode_password>0000</admin_mode_password>
    <admin_mode_password_confirm>0000</admin_mode_password_confirm>
    {% endif %}
    <!-- SIP Accounts -->
    {% for row in (lines | default('')) | values %}
    <user_active idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{% if (lookup(row | default(none), ["enabled"]) | default('')) %}on{% else %}off{% endif %}</user_active>
    <user_realname idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["display_name"]) | default(''))) | output }}</user_realname>
    <user_name idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["user_id"]) | default(''))) | output }}</user_name>
    <user_pass idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["password"]) | default(''))) | output }}</user_pass>
    <user_host idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}:{{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }}</user_host>
    <user_outbound idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{% if (lookup(row | default(none), ["outbound_proxy_primary"]) | default('')) == "" %}{{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}{% else %}{{ ((lookup(row | default(none), ["outbound_proxy_primary"]) | default(''))) | output }}{% endif %}:{{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }};transport={% if (lookup(row | default(none), ["sip_transport"]) | default('')) == 'tcp' or (lookup(row | default(none), ["sip_transport"]) | default('')) == 'tls' %}{{ ((lookup(row | default(none), ["sip_transport"]) | default(''))) | output }}{% else %}udp{% endif %},{% if (lookup(row | default(none), ["outbound_proxy_secondary"]) | default('')) == "" %}{% else %}{{ ((lookup(row | default(none), ["outbound_proxy_secondary"]) | default(''))) | output }}:{{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }};transport={% if (lookup(row | default(none), ["sip_transport"]) | default('')) == 'tcp' or (lookup(row | default(none), ["sip_transport"]) | default('')) == 'tls' %}{{ ((lookup(row | default(none), ["sip_transport"]) | default(''))) | output }}{% else %}udp{% endif %}{% endif %}</user_outbound>
    <user_expiry idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["register_expires"]) | default(''))) | output }}</user_expiry>
    <user_shared_line idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{% if (lookup(row | default(none), ["shared_line"]) | default('')) == "on" %}on{% else %}off{% endif %}</user_shared_line>
    <user_server_type idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">Default</user_server_type>
    <user_srtp idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">off</user_srtp>
    <user_mailbox idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((voicemail_number | default(''))) | output }}</user_mailbox>
    <user_symmetrical_rtp idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="">on</user_symmetrical_rtp>
    <user_ice idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="">off</user_ice>
    <stun_server idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((stun_server | default(''))) | output }}{% if ((stun_port is defined and stun_port is not none)) %}:{{ ((stun_port | default(''))) | output }}{% endif %}</stun_server>
    <stun_binding_interval idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{{ ((snom_stun_interval | default(''))) | output }}</stun_binding_interval>
    <codec_priority_list idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{% if ((snom_codec is defined and snom_codec is not none)) %}{{ ((snom_codec | default(''))) | output }}{% else %}g722,pcmu,pcma,gsm,g723,g726-32,aal2-g726-32,g729,telephone-event{% endif %}</codec_priority_list>
    <keepalive_interval idx="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" perm="RW">{% if ((snom_keepalive is defined and snom_keepalive is not none)) %}{{ ((snom_keepalive | default(''))) | output }}{% else %}5{% endif %}</keepalive_interval>
    {% if (loop.index0 | default(0) | int) == 3 %}{% break %}{% endif %}
    {% endfor %}
  </phone-settings>

  <firmware-settings>
    <firmware perm="R">{{ ((snom_firmware_url | default(''))) | output }}{{ ((snom_firmware_d715 | default(''))) | output }}</firmware>
    <firmware_uxm perm="R">{{ ((snom_firmware_url | default(''))) | output }}{{ ((snom_firmware_uxm | default(''))) | output }}</firmware_uxm>
  </firmware-settings>

  <!-- Function Keys. View Key Types here: https://service.snom.com/display/wiki/Function+Key+Types -->
  <functionKeys e="2"> {% set ns.maxKeys = 57 - ((lines | default('')) | length) %}
    {% for row in (lines | default('')) | values %}
      <fkey idx="{{ ((lookup(row | default(none), ["line_number"]) | default(0) | int)-1) | output }}" context="{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }}" label="{{ ((lookup(row | default(none), ["display_name"]) | default(''))) | output }}" perm="RW">line</fkey>
      {% if (loop.index0 | default(0) | int) == 3 %}{% break %}{% endif %}
    {% endfor %}
    {% for row in (lookup(keys | default(none), ["line"]) | default('')) | values %}
      <fkey idx="{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-1+((lines | default('')) | length)) | output }}" context="{% if (lookup(row | default(none), ["device_key_line"]) | default('')) == "" %}active{% else %}{{ ((lookup(row | default(none), ["device_key_line"]) | default(''))) | output }}{% endif %}" label="{{ ((lookup(row | default(none), ["device_key_label"]) | default(''))) | output }}" perm="RW">{{ ((lookup(row | default(none), ["device_key_type"]) | default(''))) | output }} {{ ((lookup(row | default(none), ["device_key_value"]) | default(''))) | output }}</fkey>
      {% if (loop.index0 | default('')) == (lookup(ns | default(none), ["maxKeys"]) | default('')) %}{% break %}{% endif %}
    {% endfor %}
  </functionKeys>

  <tbook e="2" complete="true">
    {% for row in (contacts | default('')) | values %}
    <item context="active" type="{% if (lookup(row | default(none), ["category"]) | default('')) == "extensions" %}colleagues{% else %}none{% endif %}" index="{{ ((loop.index0 | default(''))) | output }}">
      <first_name>{{ ((lookup(row | default(none), ["contact_name_given"]) | default(''))) | output }}</first_name>
      <last_name>{{ ((lookup(row | default(none), ["contact_name_family"]) | default(''))) | output }}</last_name>
      <number>{% if (lookup(row | default(none), ["category"]) | default('')) == "extensions" %}{{ ((lookup(row | default(none), ["phone_extension"]) | default(''))) | output }}{% else %}{{ ((lookup(row | default(none), ["phone_number"]) | default(''))) | output }}{% endif %}</number>
    </item>
    {% endfor %}
  </tbook>
</settings>
