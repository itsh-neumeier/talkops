{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, vtech/vcs754/directory.xml, blob d8d5a33075c16ca740d32e2b9ae2e49ca453f40f. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}<?xml version="1.0"?>
<directory>
<DIR_GROUP>
{% for contact in (contacts | default('')) | values %}
{% if (lookup(contact | default(none), ["contact_name_given"]) | default('')) != ""  and  (lookup(contact | default(none), ["contact_type"]) | default('')) == "contact" %}
<DIR_ENTRY>
<DIR_ENTRY_NAME_FIRST>{{ ((lookup(contact | default(none), ["contact_name_given"]) | default(''))) | output }}</DIR_ENTRY_NAME_FIRST>
<DIR_ENTRY_NAME_LAST>{{ ((lookup(contact | default(none), ["contact_name_family"]) | default(''))) | output }}</DIR_ENTRY_NAME_LAST>
<DIR_ENTRY_NUMBER_WORK>{{ ((lookup(contact | default(none), ["contact_work"]) | default(''))) | output }}</DIR_ENTRY_NUMBER_WORK>
{% if (lookup(contact | default(none), ["contact_cell"]) | default('')) != "" %}
<DIR_ENTRY_NUMBER_MOBILE>{{ ((lookup(contact | default(none), ["contact_cell"]) | default(''))) | output }}</DIR_ENTRY_NUMBER_MOBILE>
{% endif %}
{% if (lookup(contact | default(none), ["contact_home"]) | default('')) != "" %}
<DIR_ENTRY_NUMBER_OTHER>{{ ((lookup(contact | default(none), ["contact_home"]) | default(''))) | output }}</DIR_ENTRY_NUMBER_OTHER>
{% endif %}
<DIR_ENTRY_LINE_NUMBER>0</DIR_ENTRY_LINE_NUMBER>
<DIR_ENTRY_BLOCK>0</DIR_ENTRY_BLOCK>
<DIR_ENTRY_RINGER>0</DIR_ENTRY_RINGER>
</DIR_ENTRY>
{% endif %}
{% endfor %}
</DIR_GROUP>
</directory>
