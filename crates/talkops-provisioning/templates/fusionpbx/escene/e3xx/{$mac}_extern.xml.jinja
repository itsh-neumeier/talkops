	{% endif %}
{% endfor %}

	<hotlines>
	{% set ns.is_first_line = 'true' %}
	{% for row in (lookup(keys | default(none), ['memory']) | default('')) | values %}
		{% if (lookup(row | default(none), ["device_key_id"]) | default('')) != "" %}
