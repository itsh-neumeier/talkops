		<!-- ############################################################################## -->
		<!-- Enable Phonebook XML Download -->
		<!-- Disabled, EnabledUseHTTP, EnabledUseTFTP, EnabledUseHTTPS -->
		{% if is_numeric((lookup(ns | default(none), ["grandstream_phonebook_download"]) | default(''))) %}
		{% set ns.oldToNew = ["Disabled","EnabledUseHTTP","EnabledUseTFTP","EnabledUseHTTPS"] %}
		{% set ns.grandstream_phonebook_download = (lookup(ns | default(none), ["oldToNew",(lookup(ns | default(none), ["grandstream_phonebook_download"]) | default(0) | int) + 0]) | default('')) %}
