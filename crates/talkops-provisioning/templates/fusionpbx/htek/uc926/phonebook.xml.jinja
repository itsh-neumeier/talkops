		{% else %}		
			<Telephone>{{ ((lookup(number | default(none), ["phone_extension"]) | default(''))) | output }}</Telephone>
		{% endif %}
	{% endfor %}
	</DirectoryEntry>
{% elif (lookup(row | default(none), ["category"]) | default('')) == "extensions" %}
	<DirectoryEntry>
