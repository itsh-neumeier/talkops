	{% for row in (lines | default('')) | values %}
		{% if (lookup(row | default(none), ["line_number"]) | default('')) != "" %}
			{% set ns.line_subscribe_tmp = (lookup(variables | default(none), ["line_subscribe_" ~ (lookup(row | default(none), ["line_number"]) | default(''))]) | default('')) %}
			{% if (lookup(ns | default(none), ["line_subscribe_tmp"]) | default(''))=="" %} {% set ns.line_subscribe_tmp = (line_subscribe | default('')) %} {% endif %}
			{% if (lookup(ns | default(none), ["line_subscribe_tmp"]) | default(''))=="" %} {% set ns.line_subscribe_tmp = (lookup(row | default(none), ["register_expires"]) | default('')) %}  {% endif %}
			{% if (lookup(ns | default(none), ["line_subscribe_tmp"]) | default(''))<"120" %} {% set ns.line_subscribe_tmp = "120" %} {% endif %}
			{% if (lookup(variables | default(none), ["line_label_" ~ (lookup(row | default(none), ["line_number"]) | default(''))]) | default(''))== "" %}{% set ns.line_label = (label | default('')) %}{% else %}{% set ns.line_label = (lookup(variables | default(none), ["line_label_" ~ (lookup(row | default(none), ["line_number"]) | default(''))]) | default('')) %}{% endif %}

		<sipUser id="{{ ((lookup(row | default(none), ["line_number"]) | default(0) | int)-1) | output }}"
