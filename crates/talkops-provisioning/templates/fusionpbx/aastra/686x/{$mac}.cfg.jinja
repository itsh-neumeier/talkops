{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, aastra/686x/{$mac}.cfg, blob 64c51caf9ca89e3badfba9fe5c9db535eb3df27a. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}# #################
# General settings
# #################

# === passwords and access control ===
#admin password: 22222              # 22222 is the default
#user password: 123                 # default is blank
#web interface enabled: 1           # Enable/Disable Web UI
#options password enabled: 1        # default is 0 == not protected
#options simple menu: 1             # default is 0 == full options menu

# === display date and time ===
time format: 0     # 1 for 24 hr format
date format: 0     # 0 == WWW MMM DD, 1 == DD-MMM-YY, 2 == YYYY-MM-DD, see reference for others
time zone name: Custom  # Check reference for list of named time zones on page 647, or set offset below 
time zone minutes: 300  # Offset in minutes from GMT, 300 = GMT-5 = Eastern Standard Time, -120 = GMT+2 = Eastern European Time
#dst config: 3     # Day Light Savings, 0 == off, 1 == 30 min summertime, 2 == 1 hr summertime, 3 (default) == automatic
#dst minutes: 60     # amount of time to offset the clock in minutes
#dst [start|end] relative date: 1    # Specifies how to interpret the start and end day, month, and week parameters, 0 - absolute, 1 - relative 
#dst start month: 3 # March
#dst start week: 2  # Second full week of month
#dst start day: 1   # Sunday
#dst start hour: 1  # 1am
#dst end month: 11  # November
#dst end week: 1    # First full week of month
#dst end day: 1     # Sunday
#dst end hour: 1    # 1am

# === display backlight ===
backlight mode: 1  # 0 == off, 1 == auto to turn off after period of inactivity
#bl on time: 600  # time in seconds before backlight turns off if in auto


# #################
# Network Settings
# #################

# === IP network settings ===
# dhcp: 1
# subnet mask: 255.255.255.0
# default gateway: 192.168.1.1
# dns1: 192.168.1.1
# dns2: 8.8.8.8

# === NTP time server settings ===
time server disabled: 0                      # 0 == enable time server    1 = disable time server
time server1: {{ ((ntp_server_primary | default(''))) | output }}
time server2: {{ ((ntp_server_secondary | default(''))) | output }}

# === Advanced Network Settings ===
upnp manager: 0                               # Enable/Disable Universal Plug and Play
lldp: 0                                       # Enable/Disable Link-Layer Discovery Protocol


# #################
# Provisioning Settings
# #################
# phone looks for configuration files in aastra.cfg followed by <MAC>.cfg, e.g. "00085D1610DE.cfg"
# leave HTTP path blank for http://{{ ((domain_name | default(''))) | output }}{{ ((project_path | default(''))) | output }}/aastra.cfg and http://{{ ((domain_name | default(''))) | output }}{{ ((project_path | default(''))) | output }}/<MAC>.cfg
# HTTPS, TFTP and FTP also supported
download protocol: HTTP

# === HTTP Provisioning Settings ===
http server: {{ ((domain_name | default(''))) | output }}
#http port: 80
http path: /provision

# === TFTP Provisioning Settings ===
#tftp server: {{ ((domain_name | default(''))) | output }}
#tftp path: /provision/{{ ((domain_name | default(''))) | output }}

# === Provisioning Sync Settings ===
# Example below is for resyncing config (but not firmware) nightly at 2am
auto resync mode: 1
auto resync time: 02:00
auto resync max delay: 120   # in minutes
auto resync days: 1

# === Firmware Update Settings ===
# phone looks for firwmare in <phone model>.st file, e.g. "53i.st" or "57iCT.st"
#firmware server: http://{{ ((domain_name | default(''))) | output }}{{ ((project_path | default(''))) | output }}/provision/aastra/firmware
#firmware server: tftp://{{ ((domain_name | default(''))) | output }}/aastra



# #################
# SIP settings
# #################

# === Global ===
# most can be overridden per line; see below
sip vmail: {{ ((voicemail_number | default(''))) | output }}              # Voice Mail Extenstion

sip transport protocol: 1      # 0 - UDP and TCP; 1 - UDP; 2 - TCP; 4 - Transport Layer Security (TLS)
sip rport: 1                   # Random SIP port

# === SIP TLS ===
#sip persistent tls keep alive: 60          # Keep Alive Interval In seconds
#sip send sips over tls: 0
#sips persistent tls: 1
#sips root and intermediate certificates: tftp://{{ ((domain_name | default(''))) | output }}/aastra/phonesRootCert.pem   # source and name of root certificate file from configuration server
#sips local certificate: tftp://{{ ((domain_name | default(''))) | output }}/aastra/phonesLocalCert.pem                   # source and name of client certificate file from configuration server
#sips private key: tftp://{{ ((domain_name | default(''))) | output }}/aastra/phonesPrivateKey.pem                        # source and name of key file from configuration server
#sips trusted certificates: tftp://{{ ((domain_name | default(''))) | output }}/aastra/phonesTrustedCert.pem              # source and name of trusted certificates file from configuration server


# #################
# SIP settings - per-line
# #################
{% for row in (lines | default('')) | values %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} screen name: {{ ((lookup(row | default(none), ["display_name"]) | default(''))) | output }}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} user name: {{ ((lookup(row | default(none), ["user_id"]) | default(''))) | output }}  # used in SIP URI
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} password: {{ ((lookup(row | default(none), ["password"]) | default(''))) | output }}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} auth name: {{ ((lookup(row | default(none), ["user_id"]) | default(''))) | output }}  # used in Authorization header field of SIP REGISTER request
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} registrar ip: {{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}
{% if ((lookup(row | default(none), ["sip_port"]) is defined and lookup(row | default(none), ["sip_port"]) is not none)) %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} registrar port: {{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }}
{% else %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} registrar port: {{ ((line_sip_port | default(''))) | output }}
{% endif %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} proxy ip: {{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}
{% if ((lookup(row | default(none), ["sip_port"]) is defined and lookup(row | default(none), ["sip_port"]) is not none)) %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} proxy port: {{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }}
{% else %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} proxy port: {{ ((line_sip_port | default(''))) | output }}
{% endif %}
{% if ((lookup(row | default(none), ["register_expires"]) is defined and lookup(row | default(none), ["register_expires"]) is not none)) %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} registration period: {{ ((lookup(row | default(none), ["register_expires"]) | default(''))) | output }}    # requested registration period, defaults to 0
{% else %}
sip line{{ ((lookup(row | default(none), ["line_number"]) | default(''))) | output }} registration period: {{ ((line_register_expires | default(''))) | output }}    # requested registration period, defaults to 0
{% endif %}
{% endfor %}


