<configuration name="xml_cdr.conf" description="Call records to TalkOps">
  <settings>
    <param name="url" value="$${talkops_cdr_url}"/>
    <param name="cred" value="talkops:$${talkops_xmlcurl_password}"/>
    <param name="auth-scheme" value="basic"/>
    <!-- POST body is cdr=<url-encoded XML> -->
    <param name="encode" value="true"/>
    <!-- About one minute of retries covers a TalkOps restart. -->
    <param name="retries" value="5"/>
    <param name="delay" value="10"/>
    <param name="timeout" value="10"/>
    <param name="disable-100-continue" value="true"/>
    <!-- CDRs that could not be delivered go to the spool volume shared with
         TalkOps, which imports them (cdr_spool.rs). -->
    <param name="err-log-dir" value="$${talkops_cdr_spool_dir}"/>
    <param name="log-b-leg" value="false"/>
    <param name="prefix-a-leg" value="true"/>
  </settings>
</configuration>
