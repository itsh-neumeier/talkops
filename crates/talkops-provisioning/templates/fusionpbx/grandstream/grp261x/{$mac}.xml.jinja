		<!-- UNLIMITED, TLS_1_0, TLS_1_1, TLS_1_2 -->
		<item name="security.minimum.TLS.version">UNLIMITED</item>

		<!-- Maximum TLS Version -->
		<!-- UNLIMITED, TLS_1_0, TLS_1_1, TLS_1_2 -->
		<item name="security.maximum.TLS.version">UNLIMITED</item>

