expmod3 key{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-120) | output }} line: {{ ((lookup(row | default(none), ["device_key_line"]) | default(''))) | output }}
expmod3 key{{ ((lookup(row | default(none), ["device_key_id"]) | default(0) | int)-120) | output }} value: {{ ((lookup(row | default(none), ["device_key_value"]) | default(''))) | output }}
