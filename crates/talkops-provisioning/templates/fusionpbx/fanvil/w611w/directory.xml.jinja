        <Name>{{ ((lookup(row | default(none), ["contact_organization"]) | default(''))) | output }}, {{ ((lookup(row | default(none), ["contact_name_given"]) | default(''))) | output }} {{ ((lookup(row | default(none), ["contact_name_family"]) | default(''))) | output }}</Name>
    {% elif (lookup(row | default(none), ["contact_organization"]) | default(''))  and  (lookup(row | default(none), ["contact_name_given"]) | default('')) == ""  and  (lookup(row | default(none), ["contact_name_family"]) | default('')) == "" %}
        <Name>{{ ((lookup(row | default(none), ["contact_organization"]) | default(''))) | output }}</Name>
