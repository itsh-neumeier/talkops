			{% endif %}
			{% else %}
				<FirstName>{{ ((lookup(row | default(none), ["effective_caller_id_name"]) | default(''))) | output }}</FirstName>
			{% endif %}
			<JobTitle></JobTitle>

			<Frequent>0</Frequent>
			{% for number in (lookup(row | default(none), ["numbers"]) | default('')) | values %}
			{% if (lookup(number | default(none), ["phone_number"]) | default('')) != "" %}
				{% if (lookup(number | default(none), ["phone_label"]) | default('')) == "work" %}
				<Phone type="Work">
					<phonenumber>{{ ((lookup(number | default(none), ["phone_number"]) | default(''))) | output }}</phonenumber>
