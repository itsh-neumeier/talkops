{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, grandstream/grp261x/{$mac}.xml, blob ba6d0b8a5581dfb2b646d50aed7fae7a3760cca3. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}<?xml version="1.0" encoding="UTF-8"?>
<gs_provision version="1">
	<config version="2">
		<!-- Configuration Template for GRP261x Firmware Version 1.0.5.15 -->
		<!-- Instruction -->
		<!-- The new type of config template gives better understanding than P-value numbers to match the setting name from web UI or device, by using names that are similar from web UI. -->
		<!-- 1. This config template includes settings for account 1 only. To update item name to "account.i...", where i is the account index. For example, to update Account 12 SIP server address, include the following in config template: -->
		<!-- Example, <item name="account.12.sip.server.1.address">sipserver.net</item> -->
		<!-- 2. The template uses alias name to represent drop-down options. For example, Tel URI uses "Disabled, UserIsPhone, Enabled". To update this setting to "User=Phone", include the following in config template: -->
		<!-- Example, <item name="account.1.sip.telUri">UserIsPhone</item> -->
		<!-- 3. For those settings without alias, numbers are informed to match drop-down options.  -->
		<!-- End of Instruction -->

		<!-- Update since  -->

		<!-- Known issue / Notes:  -->

		<!-- Account 1 General Settings -->
		{% for line in range(1, (12) + 1) %}
		{% set ns.row = (lookup(lines | default(none), [(line | default(''))]) | default('')) %}
		<!-- Account Active -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.enable">{% if php_bool((lookup(ns | default(none), ["row","enabled"]) | default(''))) %}Yes{% else %}No{% endif %}</item>

		<!-- Account Name -->
		<item name="account.{{ ((line | default(''))) | output }}.name">{{ ((lookup(ns | default(none), ["row","display_name"]) | default(''))) | output }}</item>

		<!-- SIP Server -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.1.address">{{ ((lookup(ns | default(none), ["row","server_address"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}</item>

		<!-- Secondary SIP Server -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.2.address">{{ ((lookup(ns | default(none), ["row","secondary_server_address"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}</item>

		<!-- Outbound Proxy -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundProxy.1.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_primary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}{% endif %}</item>

		<!-- Backup Outbound Proxy -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundProxy.2.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}{% endif %}</item>

		<!-- BLF Server -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.blf.server"></item>

		<!-- SIP User ID -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.userid">{{ ((lookup(ns | default(none), ["row","user_id"]) | default(''))) | output }}</item>

		<!-- SIP Authentication ID -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.userid">{{ ((lookup(ns | default(none), ["row","auth_id"]) | default(''))) | output }}</item>

		<!-- SIP Authentication Password -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.password">{{ ((lookup(ns | default(none), ["row","password"]) | default(''))) | output }}</item>

		<!-- Name -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.name">{{ ((lookup(ns | default(none), ["row","display_name"]) | default(''))) | output }}</item>

		<!-- Voice Mail Access Number -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.voicemail.number">{{ ((voicemail_number | default(''))) | output }}</item>

		<!-- Account Display -->
		<!-- User Name, User ID-->
		<item name="account.{{ ((line | default(''))) | output }}.sip.accountDisplay">{{ ((lookup(ns | default(none), ["row","user_id"]) | default(''))) | output }}</item>

		<!-- Account 1 Network Settings -->
		<!-- DNS Mode -->
		<!-- ARecord, SRV, NaptrOrSrv, UseConfiguredIP -->
		<item name="account.{{ ((line | default(''))) | output }}.network.dnsMode">ARecord</item>

		<!-- DNS SRV Fail-over Mode -->
		<!-- Default, SavedOneUntilDNSTTL, SavedOneUntilNoResponse -->
		<item name="account.{{ ((line | default(''))) | output }}.network.dnsSRVFailoverMode">Default</item>

		<!-- Register Before DNS SRV Failover -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.network.dnsSRVRegisterBeforeFailover">No</item>

		<!-- Primary IP -->
		<item name="account.{{ ((line | default(''))) | output }}.network.primaryIp"></item>

		<!-- Backup IP 1 -->
		<item name="account.{{ ((line | default(''))) | output }}.network.backupIp.1"></item>

		<!-- Backup IP 2 -->
		<item name="account.{{ ((line | default(''))) | output }}.network.backupIp.2"></item>

		<!-- NAT Traversal -->
		<!-- No, STUN, KeepAlive, UPnP, Auto, VPN -->
		<item name="account.{{ ((line | default(''))) | output }}.network.natTraversal">Auto</item>

		<!-- Proxy-Require -->
		<item name="account.{{ ((line | default(''))) | output }}.network.proxyRequire"></item>

		<!-- Use SBC -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.network.sbc.enable">No</item>

		<!-- Account 1 SIP Settings -->
		<!-- Account 1 Basic Settings -->
		<!-- TEL URI -->
		<!-- Disabled, UserIsPhone, Enabled -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.telUri">Disabled</item>

		<!-- SIP Registration -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registration">Yes</item>

		<!-- Unregister on Reboot -->
		<!-- No, Yes, Instance -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.unregisterOnReboot">No</item>

		<!-- Register Expiration (m) -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registerExpiration">{{ ((lookup(ns | default(none), ["row","register_expires"]) | default(''))) | output }}</item>

		<!-- Subscribe Expiration (m) -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.expiration">60</item>

		<!-- Reregister before Expiration (s)  -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registerBeforeExpiration">0</item>

		<!-- Enable OPTIONS Keep Alive -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepAlive.enable">Yes</item>

		<!-- OPTIONS Keep Alive Interval (s)  -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepAlive.interval">30</item>

		<!-- OPTIONS Keep Alive Max Lost -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepAlive.maxLost">3</item>

		<!-- Local SIP Port -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.localPort">{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}</item>

		<!-- Registration Retry Wait Time (s) -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registrationFailureRetryWaitTime">20</item>

		<!-- Subscribe Retry Wait Time (s) -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribeFailureRetryWaitTime">1</item>

		<!-- SIP T1 Timeout -->
		<!-- 0.5 sec - 0.5sec, 1 sec - 1sec, 2 sec - 2sec -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.timer.t1">0.5sec</item>

		<!-- SIP T2 Interval -->
		<!-- 2 sec - 2sec, 4 sec - 4sec, 8 sec - 8sec -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.timer.t2">4sec</item>

		<!-- SIP Transport -->
		<!-- UDP, TCP, TlsOrTcp -->
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == '' %}<item name="account.{{ ((lookup(ns | default(none), ["row","line_number"]) | default(''))) | output }}.sip.transport">1</item>{% endif %}
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'udp' %}<item name="account.{{ ((lookup(ns | default(none), ["row","line_number"]) | default(''))) | output }}.sip.transport">0</item>{% endif %}
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'tcp' %}<item name="account.{{ ((lookup(ns | default(none), ["row","line_number"]) | default(''))) | output }}.sip.transport">1</item>{% endif %}
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'tls' %}<item name="account.{{ ((lookup(ns | default(none), ["row","line_number"]) | default(''))) | output }}.sip.transport">2</item>{% endif %}
	
		<!-- SIP Listening Mode -->
		<!-- TransportOnly, Dual, Dual_BLF_Enforced, Dual_Secured -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.listeningMode">TransportOnly</item>

		<!-- SIP URI Scheme When Using TLS -->
		<!-- sip, sips -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.uriSchemeWhenUsingTls">sips</item>

		<!-- Use Actual Ephemeral Port in Contact with TCP/TLS -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.useActualEphemeralPortInContactWithTcpTls">No</item>

		<!-- Outbound Proxy Mode -->
		<!-- InRoute, NotInRoute, AlwaysSentTo -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundProxy.mode">InRoute</item>

		<!-- Support SIP Instance ID -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.supportInstanceId">Yes</item>

		<!-- Subscribe for MWI -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.forMwi">{% if php_bool((subscribe_mwi_to_vm | default(''))) %}Yes{% else %}No{% endif %}</item>

		<!-- SUBSCRIBE for Registration -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.forRegistration">No</item>

		<!-- Enable 100rel -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.100rel">No</item>

		<!-- Callee ID Display -->
		<!-- Auto, Disabled, To Header - Header -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.calleeIdDisplay">Auto</item>

		<!-- Caller ID Display -->
		<!-- Auto, Disabled, From Header - Header -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.callerIdDisplay">Header</item>

		<!-- Add Auth Header On RE-REGISTER tobetested -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.authOnInitialRegister">Yes</item>

		<!-- Allow SIP Reset -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.allowSipReset">No</item>

		<!-- Ignore Alert-Info header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.ring.ignoreSipAlertInfo">No</item>


		<!-- Account 1 SIP Settings -->
		<!-- Account 1 Custom SIP Headers -->
		<!-- Use Privacy Header -->
		<!-- Default, Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.privacy">Default</item>

		<!-- Use P-Preferred-Identity Header -->
		<!-- Default, Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.ppi">Default</item>

		<!-- Use X-Grandstream-PBX Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.xGrandstream">Yes</item>

		<!-- Use P-Access-Network-Info Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.pani">Yes</item>

		<!-- Use P-Emergency-Info Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.pei">Yes</item>

		<!-- Use MAC Header -->
		<!-- No - No, Yes for REGISTER only - RegisterOnly, Yes to all SIP - YesToAllSIP -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.macHeader">No</item>

		<!-- Add MAC in User-Agent -->
		<!-- No - No, Yes for all except REGISTER - YesExceptRegister, Yes to all Sip - YesToAllSip -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.mac">No</item>

		<!-- Account 1 SIP Settings -->
		<!-- Account 1 Advanced Features -->
		<!-- Line-seize Timeout -->
		<!-- Number: 15 - 60 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.lineSeizeTimeout">15</item>

		<!-- Presence Eventlist URI -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.blf.presence.uri"></item>

		<!-- Eventlist BLF URI -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.blf.eventlist.uri"></item>

		<!-- Auto Provision Eventlists -->
		<!-- Disabled, BLFEventList, PresenceEventlist -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.blf.eventlist.autoProvision">Disabled</item>

		<!-- Conference URI -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.conferenceUri">{% if (nway_conference | default('')) == 'true' %}nway{{ ((lookup(ns | default(none), ["row","user_id"]) | default(''))) | output }}@{{ ((lookup(ns | default(none), ["row","server_address"]) | default(''))) | output }}{% endif %}</item>

		<!-- Music On Hold URI -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.musicOnHoldUri"></item>

		<!-- BLF Call-pickup  -->
		<!-- Auto, Force, Disabled -->
		{% if ((grandstream_blf_callpickup_force is defined and grandstream_blf_callpickup_force is not none)) %}
			<item name="account.{{ ((line | default(''))) | output }}.sip.blf.callPickup.forcePrefix">{{ ((grandstream_blf_callpickup_force | default(''))) | output }}</item>
		{% else %}
			<item name="account.{{ ((line | default(''))) | output }}.sip.blf.callPickup.forcePrefix">Auto</item>
		{% endif %}

		<!-- BLF Call-pickup Prefix -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.blf.callPickup.prefix">**</item>

		<!-- Call Pickup Barge-In Code -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.callPickupBargeinCode"></item>

		<!-- PUBLISH for Presence -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.publishForPresence">Yes</item>

		<!-- Omit charset=UTF-8 in MESSAGE -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.omitCharsetUtf8InMessage">No</item>

		<!-- Allow Unsolicited REFER -->
		<!-- Disabled, Enabled, EnabledOrForceAuth -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.allowUnsolicitedRefer">Disabled</item>

		<!-- Feature Key Synchronization -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.syncFeatureKey">{% if php_bool((grandstream_feature_key_sync | default(''))) %}Yes{% else %}No{% endif %}</item>

		<!-- Special Feature -->
		<!-- Standard, NortelMCS, Broadsoft, CBCOM, RNK, Sylantro, HuawaiIMS, Phonepower, UCMCallCenter -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.specialFeature">{% if ((lookup(ns | default(none), ["row","shared_line"]) is defined and lookup(ns | default(none), ["row","shared_line"]) is not none)) %}Broadsoft{% else %}Standard{% endif %}</item>

		<!-- Broadsoft Call Center -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.broadsoft.callCenter">No</item>

		<!-- Hoteling Event -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.broadsoft.hoteling">No</item>

		<!-- Call Center Status -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.broadsoft.callCenterStatus">No</item>

		<!-- Broadsoft Executive Assistant -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.broadsoft.executiveAssistant">No</item>

		<!-- Broadsoft Call Park -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.broadsoft.callPark">No</item>

		<!-- VQ RTCP-XR Collector Name -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.report.collector.name"></item>

		<!-- VQ RTCP-XR Collector Address -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.report.collector.address"></item>

		<!-- VQ RTCP-XR Collector Port -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.report.collector.port">5060</item>

		<!-- Account 1 SIP Settings -->
		<!-- Account 1 Session Timer -->
		<!-- Enable Session Timer -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.enable">No</item>

		<!-- Session Expiration (s) -->
		<!-- Session Timer is disabled if the value is 0 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.expiration">180</item>

		<!-- Min-SE(s) -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.minimumSE">90</item>

		<!-- Caller Request Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.requestTimer.caller">No</item>

		<!-- Callee Request Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.requestTimer.callee">No</item>

		<!-- Force Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.force">No</item>

		<!-- UAC Specify Refresher -->
		<!-- Omit, UAC, UAS -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.refresher.uacSpecify">UAC</item>

		<!-- UAS Specify Refresher -->
		<!--UAC - 1, UAS - 2 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.refresher.uasSpecify">1</item>

		<!-- Force INVITE -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessionTimer.forceInvite">No</item>

		<!-- Account 1 SIP Settings -->
		<!-- Account 1 Security Settings -->
		<!-- Check Domain Certificates -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.validate.domainCertificates">No</item>

		<!-- Validate Certification Chain 	 -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.validate.certificationChain">No</item>

		<!-- Validate Incoming SIP Messages -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.validate.incomingMessage">No</item>

		<!-- Check SIP User ID for Incoming INVITE  -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.validate.userIdforInvite">No</item>

		<!-- Accept Incoming SIP from Proxy Only  -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.validate.incomingServer">Yes</item>

		<!-- Authenticate Incoming INVITE -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.authenticateIncomingInvite">No</item>

		<!-- Account 1 Audio Settings -->
		<!-- Codec Settings -->
		<!-- Preferred Vocoder -->
		<!-- PCMU, PCMA, G.726-32, G.723.1, G.722, G.729A/B, iLBC, OPUS -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.1">PCMU</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.2">PCMA</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.3">G.723.1</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.4">G.729A/B</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.5">G.722</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.6">iLBC</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.7">G.726-32</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.8">OPUS</item>

		<!-- Use First Matching Vocoder in 200OK SDP -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.useFirstMatch">No</item>

		<!-- Codec Negotiation Priority -->
		<!-- Caller, Callee -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.negotiatePriority">Callee</item>

		<!-- Hide Vocoder -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.hideLabel">No</item>

		<!-- Disable Multiple m line in SDP -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.multipleMLineInSDP">No</item>

		<!-- SRTP Mode -->
		<!-- Disabled, EnabledButNotForced, EnabledAndForced, Optional -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.srtpMode">Disabled</item>

		<!-- SRTP Key Length -->
		<!-- AES128And256Bit, AES128Bit, AES256Bit -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.srtpKeyLength">AES128And256Bit</item>

		<!-- Crypto Life Time -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.cryptoLifeTime">Yes</item>

		<!-- Symmetric RTP -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.symmetricRTP">No</item>

		<!-- Silence Suppression -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.silenceSuppression">No</item>

		<!-- Jitter Buffer Type -->
		<!-- Fixed, Adaptive -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.jitterBufferType">Adaptive</item>

		<!-- Jitter Buffer Length -->
		<!-- 100ms, 200ms, 300ms, 400ms, 500ms, 600ms, 700ms, 800ms -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.jitterBufferLength">300ms</item>

		<!-- Voice Frames per TX -->
		<!-- Number: 1 - 64 -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.voiceFramePerTX">2</item>

		<!-- G723 Rate -->
		<!-- 6.3kbpsEncodingRate, 5.3kbpsEncodingRate -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.g723rate">5.3kbpsEncodingRate</item>

		<!-- G.726-32 Packing Mode -->
		<!-- ITU, IETF -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.g723.32.packingMode">ITU</item>

		<!-- iLBC Frame Size -->
		<!-- 20ms, 30ms -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.iLBC.frameSize">30ms</item>

		<!-- iLBC Payload Type -->
