{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, grandstream/ghp6xx/{$mac}.xml, blob b2b52f0a99f6b2d9a7cf6602ef4c30b3e13d71da. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}<?xml version="1.0" encoding="UTF-8"?>
<gs_provision version="1">
	<config version="2">
		<!-- Configuration Template for GHP6xx Firmware Version 1.0.1.49 -->
		<!-- Instruction -->
		<!-- The new type of config template gives better understanding than P-value numbers to match the setting name from web UI or device, by using names that are similar from web UI. -->
		<!-- 1. This config template includes settings for account 1 only. To update item name to "account.i...", where i is the account index. For example, to update Account 12 SIP server address, include the following in config template: -->
		<!-- Example, <item name="account.2.sip.server.1.address">sipserver.net</item> -->
		<!-- 2. The template uses alias name to represent drop-down options. For example, Tel URI uses "Disabled, UserIsPhone, Enabled". To update this setting to "User=Phone", include the following in config template: -->
		<!-- Example, <item name="account.1.sip.teluri">UserIsPhone</item> -->
		<!-- 3. For those settings without alias, numbers are informed to match drop-down options.  -->
		<!-- End of Instruction -->

		<!-- Update since  -->

		<!-- Known issue / Notes:  -->

		<!-- ############################################################################## -->
		<!-- ##  Account 1/ General Settings-->
		<!-- ############################################################################## -->
		{% for line in range(1, (2) + 1) %}
		{% set ns.row = (lookup(lines | default(none), [(line | default(''))]) | default('')) %}
		<!-- Account Active -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.enable">{% if php_bool((lookup(ns | default(none), ["row","enabled"]) | default(''))) %}Yes{% else %}No{% endif %}</item>

		<!-- Account Name -->
		<item name="account.{{ ((line | default(''))) | output }}.name">{{ ((lookup(ns | default(none), ["row","display_name"]) | default(''))) | output }}</item>

		<!-- SIP Server -->
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) != 'dns srv' %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.1.address">{{ ((lookup(ns | default(none), ["row","server_address"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}</item>
		{% else %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.1.address">{{ ((lookup(ns | default(none), ["row","server_address"]) | default(''))) | output }}</item>
		{% endif %}
		
		<!-- Secondary SIP Server -->
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) != 'dns srv'  and  ((lookup(ns | default(none), ["row","server_address_secondary"]) is defined and lookup(ns | default(none), ["row","server_address_secondary"]) is not none)) %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.2.address">{{ ((lookup(ns | default(none), ["row","secondary_server_address"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}</item>
		{% else %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.server.2.address">{{ ((lookup(ns | default(none), ["row","secondary_server_address"]) | default(''))) | output }}</item>
		{% endif %}

		<!-- Outbound Proxy -->
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) != 'dns srv' %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundproxy.1.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_primary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}{% endif %}</item>
		{% else %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundproxy.1.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_primary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_primary"]) | default(''))) | output }}{% endif %}</item>
		{% endif %}
		
		
		<!-- Secondary Outbound Proxy -->
		{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) != 'dns srv' %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundproxy.2.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) | default(''))) | output }}:{{ ((lookup(ns | default(none), ["row","sip_port"]) | default(''))) | output }}{% endif %}</item>
		{% else %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundproxy.2.address">{% if ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is defined and lookup(ns | default(none), ["row","outbound_proxy_secondary"]) is not none)) %}{{ ((lookup(ns | default(none), ["row","outbound_proxy_secondary"]) | default(''))) | output }}{% endif %}</item>
		{% endif %}

		<!-- SIP User ID -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.userid">{{ ((lookup(ns | default(none), ["row","user_id"]) | default(''))) | output }}</item>

		<!-- SIP Authentication ID -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.userid">{{ ((lookup(ns | default(none), ["row","auth_id"]) | default(''))) | output }}</item>

		<!-- SIP Authentication Password -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.password">{{ ((lookup(ns | default(none), ["row","password"]) | default(''))) | output }}</item>
		
		<!-- Name -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscriber.name">{{ ((lookup(ns | default(none), ["row","display_name"]) | default(''))) | output }}</item>

		<!-- Tel URI -->
		<!-- Disabled, UserIsPhone, Enabled -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.teluri">Disabled</item>
		
		<!-- Voice Mail Access Number -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.voicemail.number">{{ ((voicemail_number | default(''))) | output }}</item>
			
		
		<!-- Account 1 Network Settings -->
		<!-- DNS Mode -->
		<!-- ARecord, SRV, NaptrOrSrv, UseConfiguredIP -->
		{% set ns.dnsmode = 'ARecord' %}
		{% if ((grandstream_dns_mode is defined and grandstream_dns_mode is not none)) %}
			{% if (grandstream_dns_mode | default(0) | int) == 0 %}{% set ns.dnsmode = 'ARecord' %}{% endif %}
			{% if (grandstream_dns_mode | default(0) | int) == 1 %}{% set ns.dnsmode = 'SRV' %}{% endif %}
			{% if (grandstream_dns_mode | default(0) | int) == 2 %}{% set ns.dnsmode = 'NaptrOrSrv' %}{% endif %}
			{% if (grandstream_dns_mode | default(0) | int) == 3 %}{% set ns.dnsmode = 'UseConfiguredIP' %}{% endif %}
		{% endif %}
		<item name="account.{{ ((line | default(''))) | output }}.network.dnsmode">{{ ((lookup(ns | default(none), ["dnsmode"]) | default(''))) | output }}</item>

		<!-- NAT Traversal -->
		<!-- No, STUN -->
		{% if ((grandstream_nat_traversal is defined and grandstream_nat_traversal is not none))  and  (grandstream_nat_traversal | default(0) | int) == 1 %}
			<item name="account.{{ ((line | default(''))) | output }}.network.nattraversal">STUN</item>		
		{% else %}
			<item name="account.{{ ((line | default(''))) | output }}.network.nattraversal">No</item>		
		{% endif %}
		

		<!-- Support Rport (RFC 3581) -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.network.supportrport">Yes</item>	

		<!-- Proxy-Require -->
		<item name="account.{{ ((line | default(''))) | output }}.network.proxyrequire"></item>
		
		<!--Maximum Number of SIP Request Retries -->
		<!-- Number: 1 - 10 -->
		<item name="account.{{ ((line | default(''))) | output }}.network.maxnumofretries">2</item>

		<!-- DNS SRV Fail-over Mode -->
		<!-- Default, SavedOneUntilDNSTTL, SavedOneUntilNoResponse, SavedWhenFailback -->
		<item name="account.{{ ((line | default(''))) | output }}.network.dnssrvfailovermode">Default</item>

		<!-- Failback Expiration (m) -->
		<item name="account.{{ ((line | default(''))) | output }}.network.failbacktimer">60</item>

		<!-- Register Before DNS SRV Fail-over -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.network.dnssrvregisterbeforefailover">No</item>
				
		<!-- ############################################################################## -->
		<!-- ##  Account 1/ SIP Settings-->
		<!-- ############################################################################## -->
		<!-- Account 1 Basic Settings -->		
		<!-- SIP Registration -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registration">Yes</item>
		
		<!-- Unregister on Reboot -->
		<!-- No, Yes, Instance -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.unregisteronreboot">Instance</item>
		
		<!-- Register Expiration (m) -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registerexpiration">{{ ((lookup(ns | default(none), ["row","register_expires"]) | default(''))) | output }}</item>
		
		<!-- SUBSCRIBE Expiration (m) -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.expiration">60</item>

		<!-- Reregister before Expiration (s)  -->
		<!-- Number: 0 - 64800 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registerbeforeexpiration">0</item>

		<!-- Registration Retry Wait Time (s) -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.registrationfailureretrywaittime">20</item>

		<!-- Add Auth Header On Initial REGISTER -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.authoninitialregister">No</item>
		
		<!-- Enable OPTIONS Keep Alive -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepalive.enable">No</item>
		
		<!-- OPTIONS Keep Alive Interval (s)  -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepalive.interval">30</item>
		
		<!-- OPTIONS Keep Alive Max Lost -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.keepalive.maxlost">30</item>

		<!-- Subscribe for MWI -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.formwi">{% if ((subscribe_mwi is defined and subscribe_mwi is not none)) %}Yes{% else %}No{% endif %}</item>
		
		<!-- SUBSCRIBE for Registration -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.subscribe.forregistration">No</item>

        <!-- Use Privacy Header -->
		<!-- Default, Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.privacy">Default</item>
		
		<!-- Use P-Preferred-Identity Header -->
		<!-- Default, Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.ppi">Default</item>		
		
		<!-- Use X-Grandstream-PBX Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.xgrandstream">Yes</item>		
		
		<!-- Use P-Access-Network-Info Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.pani">Yes</item>		
		
		<!-- Use P-Emergency-Info Header -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.pei">Yes</item>

		<!-- Use MAC Header -->
		<!-- No - No, Yes for REGISTER only - Register Only, Yes to all SIP - Yes To All Sip -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.macheader">Register Only</item>	
		
		<!-- Add MAC in User-Agent -->
		<!-- No - No, Yes for all except REGISTER - Yes Except Register, Yes to all Sip - Yes To All Sip -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.mac">Yes To All Sip</item>	

		<!-- SIP Transport -->
		<!-- UDP, TCP, Tls Or Tcp -->
{% set ns.tp = 'UDP' %}
{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'udp' %}{% set ns.tp = 'UDP' %}{% endif %}
{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'tcp' %}{% set ns.tp = 'TCP' %}{% endif %}
{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'tls' %}{% set ns.tp = 'Tls Or Tcp' %}{% endif %}
{% if (lookup(ns | default(none), ["row","sip_transport"]) | default('')) == 'dns srv' %}	
    {% if ((grandstream_dnssrv_transport is defined and grandstream_dnssrv_transport is not none)) %}	
        {% if (grandstream_dnssrv_transport | default('')) == 'udp' %}{% set ns.tp = 'UDP' %}	
        {% elif (grandstream_dnssrv_transport | default('')) == 'tls' %}{% set ns.tp = 'Tls Or Tcp' %}	
        {% else %}{% set ns.tp = 'TCP' %}	
        {% endif %}	
	{% else %}{% set ns.tp = 'TCP' %}	
	{% endif %}	
{% endif %}
		<item name="account.{{ ((line | default(''))) | output }}.sip.transport">$tp</item>

		<!-- Enable TCP Keep-alive -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.enabletcpkeepalive">Yes</item>			
		
		<!-- SIP Listening Mode -->
		<!-- Transport_Only, Dual, Dual_BLF_Enforced, Dual_Secured -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.listeningmode">Transport_Only</item>
		
		<!-- Local SIP Port -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.localport">5060</item>
		
		<!-- SIP URI Scheme When Using TLS -->
		<!-- sip, sips -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.urischemewhenusingtls">sips</item>
		
		<!-- Use Actual Ephemeral Port in Contact with TCP/TLS -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.useactualephemeralportincontactwithtcptls">No</item>

		<!-- Support SIP Instance ID -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.supportinstanceid">Yes</item>

		<!-- SIP T1 Timeout -->
		<!-- 0.5 sec - 0.5sec, 1 sec - 1sec, 2 sec - 2sec -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.timer.t1">0.5sec</item>
		
		<!-- SIP T2 Timeout -->
		<!-- 2 sec - 2sec, 4 sec - 4sec, 8 sec - 8sec -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.timer.t2">4sec</item>

		<!-- Outbound Proxy Mode -->
		<!-- In Route, Not In Route, Always Sent To -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.outboundproxy.mode">In Route</item>

		<!-- Enable 100rel -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.header.100rel">No</item>	

		<!-- Use Route Set in NOTIFY(Follow RFC6665) -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.notify.route">Yes</item>

		<!-- Account 1 Session Timer -->		
		<!-- Enable Session Timer -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.enable">Yes</item>		
		
		<!-- Session Expiration (s) -->
		<!-- Session Timer is disabled if the value is 0 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.expiration">180</item>
		
		<!-- Min-SE(s) -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.minimumse">90</item>		
		
		<!-- Caller Request Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.requesttimer.caller">No</item>
		
		<!-- Callee Request Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.requesttimer.callee">No</item>		
		
		<!-- Force Timer -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.force">No</item>

		<!-- UAC Specify Refresher -->
		<!-- Omit, UAC, UAS -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.refresher.uacspecify">Omit</item>
		
		<!-- UAS Specify Refresher -->
		<!--UAC - 1, UAS - 2 -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.refresher.uasspecify">1</item>

		<!-- Force INVITE -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.sip.sessiontimer.forceinvite">No</item>

		<!-- ############################################################################## -->
		<!-- ##  Account 1/ Codec Settings-->
		<!-- ############################################################################## -->	
		<!-- Audio Settings -->
		<!-- Preferred Vocoder -->
		<!-- PCMU, PCMA, G.726-32, G.723.1, G.722, G.729A/B, iLBC, OPUS -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.1">PCMU</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.2">PCMA</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.3">G.723.1</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.4">G.729A/B</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.5">G.722</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.6">iLBC</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.7">G.726-32</item>
		<item name="account.{{ ((line | default(''))) | output }}.codec.choice.8">OPUS</item>

		<!-- Codec Negotiation Priority -->
		<!-- Caller, Callee -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.negotiatepriority">Callee</item>

		<!-- Use First Matching Vocoder in 200OK SDP -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.usefirstmatch">No</item>

		<!-- iLBC Frame Size -->
		<!-- 20ms, 30ms -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.ilbc.framesize">30ms</item>

		<!-- iLBC Payload Type -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.ilbc">97</item>

		<!-- G.726-32 Packing Mode -->
		<!-- ITU, IETF -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.g723.32.packingmode">ITU</item>

		<!-- G.726-32 Dynamic Payload Type -->
		<iitem name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.g72632">127</iitem>

		<!-- OPUS Payload Type -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.opus">123</item>

		<!-- Send DTMF -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.dtmf.sendinaudio">No</item>
		<item name="account.{{ ((line | default(''))) | output }}.dtmf.sendinrtp">Yes</item>
		<item name="account.{{ ((line | default(''))) | output }}.dtmf.sendinsip">No</item>	

		<!-- DTMF Payload Type -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.dtmf">101</item>

		<!-- Enable Audio RED with FEC -->
		<!-- Yes, No -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.fec.enable">Yes</item>

		<!-- Audio FEC Payload Type -->
		<!-- Number: 96 - 126 -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.fec.audio">121</item>

		<!-- Audio RED Payload Type -->
		<!-- Number: 96 - 126 -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.payloadtype.red">124</item>

		<!-- Silence Suppression -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.silencesuppression">No</item>
		
		<!-- Jitter Buffer Type -->
		<!-- Fixed, Adaptive -->
		{% if ((grandstream_jitter_adapt is defined and grandstream_jitter_adapt is not none))  and  (grandstream_jitter_adapt | default(0) | int) == 0 %}
		<item name="account.{{ ((line | default(''))) | output }}.audio.jitterbuffertype">Fixed</item>
		{% else %}
		<item name="account.{{ ((line | default(''))) | output }}.audio.jitterbuffertype">Adaptive</item>
		{% endif %}
		
		<!-- Jitter Buffer Length -->
		<!-- 100ms, 200ms, 300ms, 400ms, 500ms, 600ms, 700ms, 800ms -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.jitterbufferlength">300ms</item>		

		<!-- Voice Frames per TX -->
		<!-- Number: 1 - 64 -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.voiceframepertx">2</item>		

		<!-- G723 Rate -->
		<!-- 6.3kbpsEncodingRate, 5.3kbpsEncodingRate -->
		<item name="account.{{ ((line | default(''))) | output }}.codec.g723rate">5.3kbpsEncodingRate</item>

		<!-- RTP Settings -->
        <!-- SRTP Mode -->
		<!-- Disabled, EnabledButNotForced, EnabledAndForced, Optional -->
{% set ns.srtp = 'Disabled' %}		
{% if ((grandstream_srtp is defined and grandstream_srtp is not none)) %}
	{% if (grandstream_srtp | default(0) | int)==1 %}{% set ns.srtp = 'EnabledButNotForced' %}{% endif %}
	{% if (grandstream_srtp | default(0) | int)==2 %}{% set ns.srtp = 'EnabledAndForced' %}{% endif %}
	{% if (grandstream_srtp | default(0) | int)==3 %}{% set ns.srtp = 'Optional' %}{% endif %}
{% endif %}
		<item name="account.{{ ((line | default(''))) | output }}.audio.srtpmode">{{ ((lookup(ns | default(none), ["srtp"]) | default(''))) | output }}</item>

		<!-- SRTP Key Length -->
		<!-- AES128 And 256Bit, AES128 Bit, AES256 Bit -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.srtpkeylength">AES128 And 256Bit</item>

		<!-- Crypto Life Time -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.cryptolifetime">No</item>

		<!-- RTCP Mode -->
		<!-- Default, Negotiated, RTCPMux, RTCPMuxOnly -->
		<item name="account.{{ ((line | default(''))) | output }}.rtcp.port.selection">Default</item>

		<!-- RTCP Keep-Alive method -->
		<!-- ReceiverReport, SenderReport -->
		<item name="account.{{ ((line | default(''))) | output }}.rtcp.keepalivemethod">ReceiverReport</item>

		<!-- RTP Keep-Alive method -->
		<!-- RTPVersion1, No -->
		<item name="account.{{ ((line | default(''))) | output }}.rtp.keepalivemethod">RTPVersion1</item>

        <!-- Symmetric RTP -->
		<!-- No, Yes -->
		<item name="account.{{ ((line | default(''))) | output }}.audio.symmetricrtp">No</item>

		<!--RTP IP Filter -->
		<!-- Disable,IPOnly,IPandPort-->
		<item name ="account.{{ ((line | default(''))) | output }}.rtp.filter">Disable</item>

		<!--RTP Timeout(s) -->
		<item name ="account.{{ ((line | default(''))) | output }}.rtp.timeout">0</item>

		<!-- ############################################################################## -->
		<!-- ##  Account 1/ Call Settings-->
		<!-- ############################################################################## -->	
		<!-- General -->
		<!-- Key as Send -->
		<!-- Disabled, Pound, Star -->
		<item name="account.{{ ((line | default(''))) | output }}.call.keyassend">Pound</item>

		<!-- No Key Entry Timeout (s) -->
		<!-- Number: 1 - 15 -->
		<item name="account.{{ ((line | default(''))) | output }}.call.nokeyentrytimeout">4</item>

