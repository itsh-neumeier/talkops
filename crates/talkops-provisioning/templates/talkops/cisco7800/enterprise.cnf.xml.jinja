{# Independently authored experimental Enterprise profile; no firmware or trust files.
   Structure verified on a CP-7861 with sip78xx.14-2-1-0001-14: without versionStamp,
   remoteCcEnable, remotePartyID, the full port set and commonProfile the firmware
   reports "Error Verifying Config Info" and never registers. #}
<?xml version="1.0" encoding="UTF-8"?>
<device>
  <fullConfig>true</fullConfig>
  <deviceProtocol>SIP</deviceProtocol>
  <devicePool>
    <dateTimeSetting>
      <dateTemplate>D.M.Y</dateTemplate>
      <timeZone>{{ cisco_enterprise_timezone }}</timeZone>
      <ntps><ntp><name>{{ ntp_server_primary }}</name><ntpMode>unicast</ntpMode></ntp></ntps>
    </dateTimeSetting>
    {# Keep one element per line: the 14.2(1) SIP stack ignores a callManager
       nested without whitespace and then reports no valid CUCM. #}
    <callManagerGroup>
      <members>
        <member priority="0">
          <callManager>
            <ports>
              <ethernetPhonePort>2000</ethernetPhonePort>
              <sipPort>{{ account['1'].sip_port }}</sipPort>
              <securedSipPort>5061</securedSipPort>
            </ports>
            <processNodeName>{{ server_address }}</processNodeName>
          </callManager>
        </member>
      </members>
    </callManagerGroup>
  </devicePool>
  <sipProfile>
    <sipProxies><registerWithProxy>true</registerWithProxy></sipProxies>
    <sipCallFeatures><remoteCcEnable>true</remoteCcEnable></sipCallFeatures>
    <sipStack><remotePartyID>true</remotePartyID></sipStack>
    <preferredCodec>g711alaw</preferredCodec>
    <dtmfAvtPayload>101</dtmfAvtPayload>
    <phoneLabel>{{ device_label }}</phoneLabel>
    <sipLines>
{% for row in lines %}{% if row.enabled %}
      <line button="{{ loop.index }}" lineIndex="{{ loop.index }}">
        <featureID>9</featureID>
        <featureLabel>{{ row.label }}</featureLabel>
        <proxy>USECALLMANAGER</proxy><port>{{ row.sip_port }}</port>
        <name>{{ row.user_id }}</name><displayName>{{ row.display_name }}</displayName>
        <authName>{{ row.auth_id }}</authName><authPassword>{{ row.password }}</authPassword>
        <contact>{{ row.user_id }}</contact><sharedLine>false</sharedLine>
        <messagesNumber>{{ voicemail_number }}</messagesNumber>
      </line>
{% endif %}{% endfor %}
{# Button 1 is the line. Other keys are speed dials: the busy lamp needs CUCM presence. #}
{% if keys.line is mapping %}{% for id, key in keys.line|dictsort %}{% if key.device_key_id > 1 and key.device_key_type != "disabled" and key.device_key_value %}
      <line button="{{ key.device_key_id }}">
        <featureID>21</featureID>
        <featureLabel>{{ key.device_key_label or key.device_key_value }}</featureLabel>
        <speedDialNumber>{{ key.device_key_value }}</speedDialNumber>
      </line>
{% endif %}{% endfor %}{% endif %}
    </sipLines>
    <dialTemplate>dialplan.xml</dialTemplate>
  </sipProfile>
  <commonProfile><phonePassword></phonePassword></commonProfile>
  {# Cisco inverts these flags: 0 enables the read-only status web pages, 1 disables SSH. #}
  <vendorConfig><webAccess>0</webAccess><sshAccess>1</sshAccess></vendorConfig>
{% if cisco_directory_url %}  <directoryURL>{{ cisco_directory_url|safe }}</directoryURL>
{% endif %}  {# TalkOps replaces the stamp with a hash of the rendered file (ADR 0051). #}
  <versionStamp>talkops-content-hash</versionStamp>
{% if cisco_user_locale %}  {# The phone then requests sp-sip.jar from its TFTP export directory. #}
  <userLocale>
    <name>{{ cisco_user_locale.name }}</name>
    <uid>1</uid>
    <langCode>{{ cisco_user_locale.lang_code }}</langCode>
    <version>{{ cisco_user_locale.version }}</version>
    <winCharSet>utf-8</winCharSet>
  </userLocale>
{% endif %}  <deviceSecurityMode>1</deviceSecurityMode>
  <transportLayerProtocol>1</transportLayerProtocol>
</device>
