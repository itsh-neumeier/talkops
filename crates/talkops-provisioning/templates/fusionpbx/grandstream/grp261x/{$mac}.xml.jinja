		{% if ((lookup(ns | default(none), ["grandstream_phonebook_download"]) is defined and lookup(ns | default(none), ["grandstream_phonebook_download"]) is not none)) %}
		<item name="phonebook.download.server">{{ ((grandstream_phonebook_xml_server_path | default(''))) | output }}{{ ((mac | default(''))) | output }}/</item>
		{% elif ((grandstream_phonebook_xml_server_path is defined and grandstream_phonebook_xml_server_path is not none)) %}
		<item name="phonebook.download.server">{{ ((grandstream_phonebook_xml_server_path | default(''))) | output }}</item>
		{% else %}
		<item name="phonebook.download.server"></item>
