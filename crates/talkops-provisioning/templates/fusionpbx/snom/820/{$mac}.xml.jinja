{# MPL-1.1 derivative: FusionPBX 20143aec4366afc2755f336d3058243479d49d44, snom/820/{$mac}.xml, blob 93315886878b1f0e7ff74124bcf0562701d9a579. #}{% set ns = namespace(keys=keys | default({}), contact_groups=contact_groups | default({})) %}<settings>
<phone-settings>
<update_policy perm="">{% if ((snom_update_policy is defined and snom_update_policy is not none)) %}{{ ((snom_update_policy | default(''))) | output }}{% else %}auto_update{% endif %}</update_policy>
<firmware_status>{{ ((primary_url | default(''))) | output }}&amp;filename_firmware-{{ ((mac | default(''))) | output }}.xml</firmware_status>
<date_us_format>off</date_us_format>
<time_24_format>on</time_24_format>
<challenge_response>off</challenge_response>
<filter_registrar>off</filter_registrar>
<logon_wizard>off</logon_wizard>
<message_led_other>off</message_led_other>
<user_phone>off</user_phone>
<intercom_enabled>on</intercom_enabled>
{% if ((admin_password is defined and admin_password is not none)) %}
<http_user perm="">{{ ((admin_name | default(''))) | output }}</http_user>
<http_pass perm="">{{ ((admin_password | default(''))) | output }}</http_pass>
{% endif %}
<web_logout_timer>5</web_logout_timer>
{% if ((admin_password is defined and admin_password is not none)) %}
<admin_mode_login perm="">{{ ((admin_name | default(''))) | output }}</admin_mode_login>
<admin_mode_password perm="">{{ ((admin_password | default(''))) | output }}</admin_mode_password>
<admin_mode_password_confirm perm="">{{ ((admin_password | default(''))) | output }}</admin_mode_password_confirm>
{% else %}
<admin_mode_password>0000</admin_mode_password>
<admin_mode_password_confirm>0000</admin_mode_password_confirm>
{% endif %}
<language>English</language>
<ntp_server>{{ ((ntp_server_primary | default(''))) | output }}</ntp_server>
<timezone>AUS+10</timezone>
<dst>3600 25.09 02:00:00 04.05 03:00:00</dst>
<tone_scheme>US</tone_scheme>
<ring_sound>Ringer9</ring_sound>
<no_dnd>off</no_dnd>
<call_waiting>on</call_waiting>
<user_realname idx="1">{{ ((lookup(user | default(none), ["1","display_name"]) | default(''))) | output }}</user_realname>
<user_name idx="1">{{ ((lookup(user | default(none), ["1","user_id"]) | default(''))) | output }}</user_name>
<user_host idx="1">{{ ((lookup(user | default(none), ["1","server_address"]) | default(''))) | output }}</user_host>
<user_outbound idx="1">{{ ((lookup(user | default(none), ["1","outbound_proxy"]) | default(''))) | output }}</user_outbound>
<user_password idx="1">{{ ((lookup(user | default(none), ["1","password"]) | default(''))) | output }}</user_password>
<user_ringer idx="1">Ringer9</user_ringer>
<user_mailbox idx="1">4000</user_mailbox>
<user_expiry idx="1" perm="">{{ ((lookup(user | default(none), ["1","register_expires"]) | default(''))) | output }}</user_expiry>
<user_srtp idx="1" perm="">off</user_srtp>
</phone-settings>
<function-keys>
<fkey context="active" idx="0">line</fkey>
<fkey context="active" idx="1">blf sip:1002@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="2">blf sip:1003@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="3">blf sip:1004@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="4">blf sip:1005@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="5">blf sip:1006@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="6">line</fkey>
<fkey context="active" idx="7">blf sip:1007@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="8">blf sip:1008@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="9">blf sip:1009@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="10">blf sip:1010@{{ ((domain_name | default(''))) | output }}</fkey>
<fkey context="active" idx="11">blf sip:1011@{{ ((domain_name | default(''))) | output }}</fkey>
</function-keys>
<dialplan>
<!-- Handset Dialplan Mask, VERY similar to Cisco format... -->
<template Timeout="0" User="phone" match="0" rewrite="" scheme="sip"></template>
<template Timeout="8" User="phone" match="1*" rewrite="" scheme="sip"></template>
</dialplan>
</settings>
