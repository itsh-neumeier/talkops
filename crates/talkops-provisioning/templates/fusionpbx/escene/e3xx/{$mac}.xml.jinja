			Describe="{{ ((lookup(ns | default(none), ["line_label"]) | default(''))) | output }}"
			DomainName="{{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}"
			UserName="{{ ((lookup(row | default(none), ["display_name"]) | default(''))) | output }}"
			UserNumber="{{ ((lookup(row | default(none), ["user_id"]) | default(''))) | output }}"
			approveName="{{ ((lookup(row | default(none), ["auth_id"]) | default(''))) | output }}"
			Password="{{ ((lookup(row | default(none), ["password"]) | default(''))) | output }}"
			ProxyServerAddress="{% if (lookup(row | default(none), ["outbound_proxy"]) | default('')) != '' %}{{ ((lookup(row | default(none), ["outbound_proxy"]) | default(''))) | output }}{% else %}{{ ((lookup(row | default(none), ["server_address"]) | default(''))) | output }}{% endif %}{% if (lookup(row | default(none), ["sip_port"]) | default('')) != '5060' %}:{{ ((lookup(row | default(none), ["sip_port"]) | default(''))) | output }}{% endif %}"
			LinkUse="{% if (lookup(row | default(none), ["sip_transport"]) | default(''))=='tcp' %}1{% elif (lookup(row | default(none), ["sip_transport"]) | default(''))=='tls' %}2{% else %}0{% endif %}"
